# Environment Variables for EMI Calculator with Enhanced Stock Analysis
# Copy this file to .env and fill in your actual values

# ===========================================
# REQUIRED: Google Custom Search API
# ===========================================
# Get these from Google Cloud Console
# 1. Enable Custom Search API
# 2. Create API key
# 3. Set up Custom Search Engine at https://programmablesearchengine.google.com/
REACT_APP_GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
REACT_APP_GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# For Vercel deployment, also set these in Vercel dashboard:
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ===========================================
# REQUIRED: OpenAI API (for AI Analysis)
# ===========================================
# Get from https://platform.openai.com/
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# GROWW API (for Automated Stock Data)
# ===========================================
# Get these from: https://groww.in/trade-api/dashboard
# This enables automated token generation - no more manual daily updates!

# Your Groww API Key (starts with eyJraWQi...)
REACT_APP_GROWW_API_KEY=your_api_key_here

# Your TOTP Secret (Base32 string like RIKJ6DLTOKBLXQTQFQPWQJGTPGSPXQNU)
REACT_APP_GROWW_TOTP_SECRET=your_totp_secret_here

# Legacy manual token (will be automatically replaced by generated tokens)
# GROWW_ACCESS_TOKEN=your_manual_token_here

# ===========================================
# OPTIONAL: Vercel Configuration
# ===========================================
# Set this if you want to use a specific Vercel URL for API calls
# Leave empty to use relative paths (recommended)
REACT_APP_VERCEL_API_URL=

# ===========================================
# DEVELOPMENT ONLY: Python Scraper
# ===========================================
# For local development with Python scraper
REACT_APP_PYTHON_SCRAPER_URL=http://localhost:5000

# ===========================================
# VERCEL ENVIRONMENT VARIABLES SETUP
# ===========================================
# In Vercel Dashboard, add these environment variables:
# 
# Production:
# - GOOGLE_SEARCH_API_KEY = your_google_search_api_key_here
# - GOOGLE_SEARCH_ENGINE_ID = your_search_engine_id_here
# - REACT_APP_GOOGLE_SEARCH_API_KEY = your_google_search_api_key_here
# - REACT_APP_GOOGLE_SEARCH_ENGINE_ID = your_search_engine_id_here
# - REACT_APP_OPENAI_API_KEY = your_openai_api_key_here
# - REACT_APP_GROWW_API_KEY = your_groww_api_key_here
# - REACT_APP_GROWW_TOTP_SECRET = your_groww_totp_secret_here
#
# Preview/Development:
# - Same as production
# 
# Note: Don't add REACT_APP_VERCEL_API_URL - it should auto-detect