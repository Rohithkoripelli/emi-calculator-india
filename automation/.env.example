# Groww Token Automation Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# GROWW CREDENTIALS
# ===========================================
# Your Google email used for Groww login
GROWW_GOOGLE_EMAIL=your.email@gmail.com

# Your Google password
GROWW_GOOGLE_PASSWORD=your_google_password

# Your Groww PIN (4 or 6 digits)
GROWW_PIN=1234

# ===========================================
# VERCEL API CREDENTIALS
# ===========================================
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Get from your Vercel project settings
VERCEL_PROJECT_ID=your_project_id_here

# ===========================================
# AUTOMATION SETTINGS
# ===========================================
# Set to 'production' for headless mode
NODE_ENV=development

# Set to 'true' for testing without actual updates
TEST_MODE=false

# ===========================================
# GITHUB SECRETS SETUP
# ===========================================
# Add these secrets to your GitHub repository:
# 
# Repository Settings → Secrets and Variables → Actions → New repository secret
# 
# Required secrets:
# - GROWW_GOOGLE_EMAIL
# - GROWW_GOOGLE_PASSWORD  
# - GROWW_PIN
# - VERCEL_TOKEN
# - VERCEL_PROJECT_ID
#
# Security Tips:
# 1. Use a dedicated Google App Password instead of your main password
# 2. Enable 2FA on your Vercel account
# 3. Use minimal scope Vercel tokens
# 4. Regularly rotate your credentials